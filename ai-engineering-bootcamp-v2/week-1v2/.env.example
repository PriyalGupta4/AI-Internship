# OpenAI — used for chat (/ask) and for embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Pinecone — create a serverless index with dimension 1536, metric cosine
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Optional: index host URL from the Pinecone console (skips a lookup on startup)
PINECONE_INDEX_HOST=
# Optional: namespace inside the index (blank = default namespace)
PINECONE_NAMESPACE=

# Optional: chunking for POST /ingest, in characters (defaults 800 / 100)
CHUNK_SIZE=
CHUNK_OVERLAP=
